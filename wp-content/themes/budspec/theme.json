{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Tło",
					"slug": "base"
				},
				{
					"color": "#1a1a1a",
					"name": "Tekst",
					"slug": "contrast"
				},
				{
					"color": "#0a546e",
					"name": "Kolor marki",
					"slug": "primary"
				},
				{
					"color": "#8a3b00",
					"name": "Akcent",
					"slug": "accent"
				}
			]
		},
		"layout": {
			"contentSize": "820px",
			"wideSize": "1200px"
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Advent Pro\", \"Segoe UI\", Roboto, sans-serif",
					"name": "Advent Pro (Marka)",
					"slug": "brand"
				},
				{
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"name": "Systemowa bezszeryfowa",
					"slug": "system-sans"
				}
			],
			"fontSizes": [
				{
					"name": "Mały",
					"size": "0.9rem",
					"slug": "small"
				},
				{
					"name": "Podstawowy",
					"size": "1.05rem",
					"slug": "medium"
				},
				{
					"name": "Duży",
					"size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)",
					"slug": "large"
				},
				{
					"name": "Nagłówek H1",
					"size": "clamp(1.75rem, 1.2rem + 2.5vw, 3rem)",
					"slug": "x-large"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				"border": {
					"radius": "6px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--brand)",
					"fontWeight": "800",
					"lineHeight": "1.2"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Nagłówek"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Stopka"
		}
	]
}