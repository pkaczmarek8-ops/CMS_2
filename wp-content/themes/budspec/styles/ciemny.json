{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ciemny",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#121212", "name": "Tło" },
				{ "slug": "contrast", "color": "#f2f2f2", "name": "Tekst" },
				{ "slug": "primary", "color": "#7cc4e0", "name": "Kolor marki" },
				{ "slug": "accent", "color": "#f4a261", "name": "Akcent" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		}
	}
}